　<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AOKICKS風サイト</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:sans-serif;
  background:#fff;
}

/* ヘッダー */
header{
  display:flex;
  justify-content:space-between;
  align-items:center;
  padding:15px 20px;
  border-bottom:1px solid #ddd;
  position:sticky;
  top:0;
  background:white;
}

.logo{
  font-size:24px;
  font-weight:bold;
}

.icons{
  display:flex;
  gap:15px;
}

.icon{
  font-size:24px;
  cursor:pointer;
  position:relative;
}

/* メニュー */
.menu{
  position:fixed;
  top:0;
  left:0;
  transform:translateX(-100%);
  transition:.4s;
  width:250px;
  height:100%;
  background:white;
  color:black;
  z-index:1000;
  box-shadow:0 0 20px rgba(0,0,0,.15);
}

.menu.active{
  transform:translateX(0);
}

.menu a{
  display:block;
  color:black;
  text-decoration:none;
  padding:15px 20px;
}

.menu a:hover{
  background:#333;
  color:white;
}

/* ヒーロー */
.hero{
  height:350px;
  background:url("https://picsum.photos/1200/500?1")
  center/cover;
  display:flex;
  align-items:center;
  justify-content:center;
  color:white;
}

.hero h1{
  font-size:40px;
  background:rgba(0,0,0,.5);
  padding:10px 20px;
}

/* 商品 */
.products{
  padding:40px 20px;
}

.products h2{
  text-align:center;
  margin-bottom:30px;
}

.grid{
  display:grid;
  grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
  gap:20px;
}

.card{
  border:1px solid #ddd;
  text-align:center;
  padding:10px;
  transition:.3s;
}

.card img{
  width:100%;
}

.card h3{
  margin:10px 0;
}

button{
  display:block;
  width:100%;
  padding:10px 20px;
  background:black;
  color:white;
  border:none;
  cursor:pointer;
  margin-top:10px;
}

.card img{
  transition:.3s;
}

.card img:hover{
  transform:scale(1.05);
}

#cartCount{
  font-size:14px;
  margin-left:3px;
  color:red;
  font-weight:bold;
}

/* フッター */
footer{
  background:#111;
  color:white;
  text-align:center;
  padding:30px;
  margin-top:50px;
}

.search-box{
  position:fixed;
  top:-80px;
  left:0;
  width:100%;
  background:white;
  padding:15px;
  border-bottom:1px solid #ddd;
  transition:0.3s;
  z-index:999;
}

.search-box.active{
  top:60px;
}

.search-box input{
  width:100%;
  padding:12px;
  font-size:16px;
  border:1px solid #ccc;
  outline:none;
}

.card:hover{
 transform:translateY(-8px);
 box-shadow:
 0 10px 25px rgba(0,0,0,.15);
}

#cartCount{
 position:absolute;
 top:-5px;
 right:-5px;
 background:red;
 color:white;
 border-radius:50%;
 width:20px;
 height:20px;
 display:flex;
 align-items:center;
 justify-content:center;
}

.overlay{
 position:fixed;
 inset:0;
 background:rgba(0,0,0,.4);
 display:none;
}

.overlay.active{
 display:block;
}

.action-buttons{
  display:flex;
  justify-content:center;
  gap:15px;
  padding:30px 20px;
}

.action-buttons button{
  width:auto;
  min-width:160px;
}

</style>
</head>

<body>

<div id="overlay" class="overlay"></div>

<div class="menu" id="menu">
  <a href="#">HOME</a>
  <a href="#">SHOP</a>
  <a href="#">NEW</a>
  <a href="#">CONTACT</a>
</div>

<header>
  <div class="icon" onclick="toggleMenu()">☰</div>

  <div class="logo">AOKICKS</div>

  <div class="icons">
    <div class="icon" onclick="searchProduct()">🔍</div>
    <div class="icon" onclick="showCart()">🛒<span id="cartCount">0</span>
    </div>
  </div>

  <div id="searchBox" class="search-box">
  <input
    type="text"
    id="searchInput"
    placeholder="商品検索..."
  >
</div>
</header>


<section class="hero">
  <h1>GET BUCKETS OR DIE</h1>
</section>

<section class="products">
  <h2>人気商品</h2>

  <div class="grid">

    <div class="card">
      <img src="https://picsum.photos/300/300?1">
      <h3>Basketball Tee</h3>
      <p>¥4,980</p>
      <button onclick="addCart()">カートに追加</button>
    </div>

    <div class="card">
      <img src="https://picsum.photos/300/300?2">
      <h3>Hoodie</h3>
      <p>¥8,980</p>
      <button onclick="addCart()">カートに追加</button>
    </div>

    <div class="card">
      <img src="https://picsum.photos/300/300?3">
      <h3>Basketball Socks</h3>
      <p>¥1,980</p>
      <button onclick="addCart()">カートに追加</button>
    </div>

    <div class="card">
      <img
 src="https://picsum.photos/300/300?10"
>
      <h3>Air Jordan 4</h3>
      <p>¥32,450</p>
      <button onclick="event.stopPropagation(); addCart()">カートに追加</button>
    </div>

 </div>
</section>

<div class="action-buttons">
<button onclick="resetCart()">カートを空にする</button>

<button onclick="toggleFavorite()">
❤️ お気に入り
</button>
</div>

<footer>
  <p>© 2026 AOKICKS STYLE</p>

  
 
</footer>

<script>
function toggleMenu(){
  document
    .getElementById("menu")
    .classList
    .toggle("active");

  document
    .getElementById("overlay")
    .classList
    .toggle("active");
}

function searchProduct(){
  document
    .getElementById("searchBox")
    .classList
    .toggle("active");
}

let cart =  
parseInt(
localStorage.getItem("cart") ||0
);

document.getElementById("cartCount").textContent= cart;

function showCart(){
  alert("現在の商品数：" + cart);
}

const searchInput =
document.getElementById("searchInput");

searchInput.addEventListener("keyup", ()=>{

 const keyword =
 searchInput.value.toLowerCase();

 const cards =
 document.querySelectorAll(".card");

 cards.forEach(card=>{

  const name =
  card.querySelector("h3")
  .textContent
  .toLowerCase();

  if(name.includes(keyword)){
   card.style.display="";
  }else{
   card.style.display="none";
  }

 });

});

const images = [
"https://picsum.photos/1200/500?1",
"https://picsum.photos/1200/500?2",
"https://picsum.photos/1200/500?3"
];

let current = 0;

setInterval(()=>{

 current++;

 if(current >= images.length){
   current = 0;
 }

 document.querySelector(".hero")
 .style.backgroundImage =
 `url(${images[current]})`;

},3000);

function addCart(){

 cart++;

 document.getElementById("cartCount").textContent = cart;

 localStorage.setItem("cart",cart);

 alert("カートに追加しました");
}

const menu =
document.getElementById("menu");

document.addEventListener("click",(e)=>{

 if(
   !menu.contains(e.target) &&
   !e.target.matches(".icon")
 ){
   menu.classList.remove("active");

document
 .getElementById("overlay")
 .classList
 .remove("active");
 }

});

function openProduct(name){
 alert(name);
}

function resetCart(){

 if(!confirm("カートを空にしますか？")){
   return;
 }

 cart = 0;

 localStorage.setItem("cart",0);

 document.getElementById("cartCount")
 .textContent = 0;
}

const products = [
 {
  name:"Basketball Tee",
  price:"4980",
  image:"..."
 },
 {
  name:"Hoodie",
  price:"8980",
  image:"..."
 }
];

function toggleFavorite(){
  alert("お気に入り登録しました");
}


</script>

</body>
</html>
