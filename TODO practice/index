<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>JavaScript TODOアプリ</title>

<style>
*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

body{
  font-family:sans-serif;
  background:#f5f5f5;
  padding:50px 20px;
  text-align:center;
}

h1{
  font-size:48px;
  margin-bottom:40px;
}

.input-area{
  display:flex;
  justify-content:center;
  gap:10px;
  flex-wrap:wrap;
}

input{
  width:min(420px,100%);
  padding:16px;
  font-size:24px;
  border:2px solid #ccc;
  border-radius:10px;
}

button{
  padding:16px 24px;
  font-size:20px;
  border:none;
  border-radius:10px;
  cursor:pointer;
  transition:.3s;
}

#addBtn{
  background:#007bff;
  color:#fff;
}

#addBtn:hover{
  background:#0056b3;
}

ul{
  list-style:none;
  margin-top:40px;
}

li{
  width:min(700px,100%);
  margin:20px auto;
  padding:20px;
  background:#fff;
  border-radius:12px;
  display:flex;
  align-items:center;
  box-shadow:0 3px 10px rgba(0,0,0,.1);
}

li span{
  flex:1;
  text-align:left;
  font-size:24px;
  word-break:break-word;
}

.done{
  text-decoration:line-through;
  color:gray;
}

.done-btn{
  background:#28a745;
  color:#fff;
  margin-left:10px;
}

.done-btn:hover{
  background:#1f7f35;
}

.delete-btn{
  background:#dc3545;
  color:#fff;
  margin-left:10px;
}

.delete-btn:hover{
  background:#b52a37;
}

@media(max-width:768px){

  h1{
    font-size:36px;
  }

  input{
    width:100%;
    font-size:20px;
  }

  .input-area{
    flex-direction:column;
    align-items:center;
  }

  #addBtn{
    width:100%;
    max-width:420px;
  }

  li{
    flex-wrap:wrap;
    gap:10px;
  }

  li span{
    width:100%;
    margin-bottom:10px;
    font-size:20px;
  }

  .done-btn,
  .delete-btn{
    flex:1;
    margin-left:0;
  }

}
</style>
</head>

<body>

<h1>📝 TODOアプリ</h1>

<div class="input-area">
  <input type="text" id="todoInput" placeholder="やることを入力">
  <button id="addBtn">追加</button>
</div>

<ul id="todoList"></ul>

<script>
const input = document.getElementById("todoInput");
const addBtn = document.getElementById("addBtn");
const list = document.getElementById("todoList");

function addTodo(){

  const text = input.value.trim();

  if(text === ""){
    alert("入力してください");
    return;
  }

  const li = document.createElement("li");

  const span = document.createElement("span");
  span.textContent = text;

  const doneBtn = document.createElement("button");
  doneBtn.textContent = "完了";
  doneBtn.className = "done-btn";

  const deleteBtn = document.createElement("button");
  deleteBtn.textContent = "削除";
  deleteBtn.className = "delete-btn";

  doneBtn.addEventListener("click",()=>{
    span.classList.toggle("done");
  });

  deleteBtn.addEventListener("click",()=>{
    li.remove();
  });

  li.appendChild(span);
  li.appendChild(doneBtn);
  li.appendChild(deleteBtn);

  list.appendChild(li);

  input.value = "";
  input.focus();
}

addBtn.addEventListener("click", addTodo);

input.addEventListener("keydown",(e)=>{
  if(e.key==="Enter"){
    addTodo();
  }
});
</script>

</body>
</html>
