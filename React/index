import { Link } from "wouter";
import { useState, useEffect } from "react";
import { Button } from "@/components/ui/button";
import { 
  Zap, 
  Layers, 
  Paintbrush, 
  FileCode2, 
  Rocket, 
  ArrowRight,
  CheckCircle2
} from "lucide-react";

export default function Home() {
  
  const [count, setCount] = useState(0);
  const [text, setText] = useState("");
  const [todos, setTodos] = useState<
    { text: string; completed: boolean }[]
  >([]);

  const [editingIndex, setEditingIndex] = useState<number | null>(null);
  const [editingText, setEditingText] = useState("");
  
  useEffect(() => {
    const saved = localStorage.getItem("todos");

    if (saved) {
      setTodos(JSON.parse(saved));
    }
  }, []);

  useEffect(() => {
    localStorage.setItem("todos", JSON.stringify(todos));
  }, [todos]);
  
  const deleteTodo = (index: number) => {
    setTodos(todos.filter((_, i) => i !== index));
  };
  
  return (
    <div className="flex flex-col w-full min-h-[calc(100vh-4rem)]">
      {/* Hero Section */}
      <section className="relative overflow-hidden bg-background pt-24 pb-32">
        {/* Background Grid Pattern */}
        <div className="absolute inset-0 bg-[linear-gradient(to_right,#80808012_1px,transparent_1px),linear-gradient(to_bottom,#80808012_1px,transparent_1px)] bg-[size:24px_24px]"></div>
        <div className="absolute left-0 right-0 top-0 -z-10 m-auto h-[310px] w-[310px] rounded-full bg-primary/20 opacity-30 blur-[100px]"></div>
        
        <div className="container relative z-10 mx-auto px-4 md:px-6 flex flex-col items-center text-center">
          <div className="inline-flex items-center rounded-full border border-primary/20 bg-primary/10 px-3 py-1 text-sm font-medium text-primary mb-8 animate-in fade-in slide-in-from-bottom-4 duration-500">
            <Rocket className="mr-2 h-4 w-4" />
            <span>Ready for production</span>
          </div>
          
          <h1 className="max-w-4xl text-5xl font-extrabold tracking-tight sm:text-6xl md:text-7xl lg:text-8xl text-foreground animate-in fade-in slide-in-from-bottom-6 duration-700 delay-100">
            学習スタート
          </h1>
          <div className="mt-10">
            <h2 className="text-3xl font-bold mb-4">
              React ToDo
            </h2>

            <input
              className="border p-2 rounded text-black"
              value={text}
              onChange={(e) => setText(e.target.value)}
              placeholder="やることを入力"
            />

            <Button
              className="ml-2"
              onClick={() => {
                if (text === "") return;

                setTodos([...todos,
                          {
                            text: text,
                            completed: false,
                          },
                         ]);
                setText("");
              }}
            >
              追加
            </Button>

            <ul className="mt-6 space-y-2">
              {todos.map((todo, index) => (
                <li
                  key={index}
                  className="flex items-center justify-between border p-2 rounded"
                >
                  {editingIndex === index ? (
                    <>
                      <input
                        value={editingText}
                        onChange={(e) => setEditingText(e.target.value)}
                        className="border p-1 rounded text-black"
                      />

                      <Button
                        onClick={() => {
                          const newTodos = [...todos];
                          newTodos[index].text = editingText;
                          setTodos(newTodos);
                          setEditingIndex(null);
                        }}
                        >
        
                        保存
                      </Button>

                      <Button 
                        variant="outline"
                        onClick={() => {
                          setEditingIndex(null);
                          setEditingText("");
                        }}
                      >

                        キャンセル
                      </Button>
                    </>
                  ) : (
                    <span
                      className={
                        todo.completed
                          ? "line-through text-gray-500"
                          : ""
                      }
                    >
                      {todo.text}
                    </span>
                  )}

                  <div className="flex gap-2">
                    <Button
                      onClick={() => {
                        const newTodos = [...todos];
                        newTodos[index].completed =
                          !newTodos[index].completed;
                        setTodos(newTodos);
                      }}
                    >
                      完了
                    </Button>

                    {editingIndex !== index && (
                <>
                  
                    <Button
                      onClick={() => {
                        setEditingIndex(index);
                        setEditingText(todo.text);
                      }}
                    >
                      編集
                    </Button>
                    
                    <Button
                      variant="destructive"
                      onClick={() => deleteTodo(index)}
                    >
                      削除
                    </Button>
                  </>
                  )}
                  </div>
                </li>
              ))}
              
            </ul>
          </div>
          <div className="mt-6">
            <h2 className="text-4xl font-bold">{count}</h2>

            <Button
              className="mt-4"
              onClick={() => setCount(count + 1)}
            >
              +1
            </Button>
          </div>
          <p className="mt-6 max-w-2xl text-lg text-muted-foreground md:text-xl leading-relaxed animate-in fade-in slide-in-from-bottom-8 duration-700 delay-200">
            A meticulously crafted React starter template powered by Vite. 
            Everything you need to build fast, scalable web applications with a world-class developer experience.
          </p>
          
          <div className="mt-10 flex flex-col sm:flex-row gap-4 animate-in fade-in slide-in-from-bottom-10 duration-700 delay-300">
            <Button size="lg" asChild className="group font-semibold text-base h-12 px-8 shadow-lg shadow-primary/20">
              <Link href="/about">
                Explore the Stack
                <ArrowRight className="ml-2 h-4 w-4 transition-transform group-hover:translate-x-1" />
              </Link>
            </Button>
            <Button size="lg" variant="outline" asChild className="font-semibold text-base h-12 px-8 bg-background/50 backdrop-blur-sm">
              <a href="https://vitejs.dev" target="_blank" rel="noreferrer">
                Read Vite Docs
              </a>
            </Button>
          </div>
        </div>
      </section>

      {/* Features Section */}
      <section className="py-24 bg-muted/30 border-y border-border/50 relative overflow-hidden">
        <div className="container mx-auto px-4 md:px-6">
          <div className="mb-16 md:text-center">
            <h2 className="text-3xl font-bold tracking-tight sm:text-4xl text-foreground">The Modern Standard</h2>
            <p className="mt-4 text-lg text-muted-foreground md:max-w-2xl md:mx-auto">
              Pre-configured with the best tools in the ecosystem so you can focus on writing code instead of wiring up build tools.
            </p>
          </div>
          
          <div className="grid gap-8 md:grid-cols-2 lg:grid-cols-4">
            {features.map((feature,) => (
              <div 
                key={feature.title} 
                className="relative group rounded-2xl border border-border/50 bg-card p-8 shadow-sm transition-all hover:shadow-md hover:border-primary/30 hover:-translate-y-1 duration-300"
              >
                <div className="mb-6 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:scale-110 transition-transform duration-300">
                  {feature.icon}
                </div>
                <h3 className="mb-2 text-xl font-bold text-foreground">{feature.title}</h3>
                <p className="text-muted-foreground leading-relaxed">
                  {feature.description}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* Philosophy Section */}
      <section className="py-24 bg-background">
        <div className="container mx-auto px-4 md:px-6">
          <div className="grid md:grid-cols-2 gap-16 items-center">
            <div>
              <h2 className="text-3xl font-bold tracking-tight sm:text-4xl mb-6 text-foreground">Built for speed and developer happiness.</h2>
              <div className="space-y-6">
                {[
                  "Instant server start with Vite's native ESM",
                  "Lightning fast HMR (Hot Module Replacement)",
                  "Strict TypeScript configuration out of the box",
                  "Tailwind CSS ready with custom theme variables",
                  "Beautiful, accessible UI components scaffolded"
                ].map((item, i) => (
                  <div key={i} className="flex items-start gap-3">
                    <CheckCircle2 className="h-6 w-6 text-primary shrink-0" />
                    <span className="text-lg text-muted-foreground">{item}</span>
                  </div>
                ))}
              </div>
            </div>
            <div className="relative rounded-2xl border border-border bg-card shadow-2xl overflow-hidden aspect-square md:aspect-auto md:h-[500px] flex flex-col group">
              <div className="h-12 border-b border-border flex items-center px-4 gap-2 bg-muted/50">
                <div className="flex gap-2">
                  <div className="w-3 h-3 rounded-full bg-red-400"></div>
                  <div className="w-3 h-3 rounded-full bg-yellow-400"></div>
                  <div className="w-3 h-3 rounded-full bg-green-400"></div>
                </div>
                <div className="ml-4 text-xs font-mono text-muted-foreground flex-1 text-center pr-10">src/App.tsx</div>
              </div>
              <div className="flex-1 p-6 font-mono text-sm sm:text-base text-foreground/80 overflow-hidden relative selection:bg-primary/20">
                <pre className="text-emerald-500 inline">import</pre> {'{'} useState {'}'} <pre className="text-emerald-500 inline">from</pre> <span className="text-amber-500">'react'</span>;<br/>
                <br/>
                <pre className="text-primary inline">export default function</pre> <span className="text-blue-500 font-bold">App</span>() {'{'}<br/>
                {'  '}<pre className="text-emerald-500 inline">return</pre> (<br/>
                {'    '}<span className="text-purple-500">{'<div'}</span> <span className="text-blue-400">className</span>=<span className="text-amber-500">"min-h-screen"</span><span className="text-purple-500">{'>'}</span><br/>
                {'      '}<span className="text-purple-500">{'<Navbar />'}</span><br/>
                {'      '}<span className="text-purple-500">{'<main>'}</span><br/>
                {'        '}<span className="text-purple-500">{'<Router />'}</span><br/>
                {'      '}<span className="text-purple-500">{'</main>'}</span><br/>
                {'    '}<span className="text-purple-500">{'</div>'}</span><br/>
                {'  '});<br/>
                {'}'}
                <div className="absolute inset-0 bg-gradient-to-t from-card via-transparent to-transparent h-full w-full pointer-events-none opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  );
}

const features = [
  {
    title: "React 19",
    description: "The latest rendering engine with server components, actions, and compiler optimizations.",
    icon: <Layers className="h-6 w-6" />
  },
  {
    title: "Vite 6",
    description: "Next generation frontend tooling. Instant server start and lightning-fast HMR.",
    icon: <Zap className="h-6 w-6" />
  },
  {
    title: "Tailwind CSS",
    description: "Utility-first CSS framework for rapid UI development with a bespoke design system.",
    icon: <Paintbrush className="h-6 w-6" />
  },
  {
    title: "TypeScript",
    description: "Strongly typed by default. Catch errors early and improve your developer experience.",
    icon: <FileCode2 className="h-6 w-6" />
  }
];

